# ---------------------------------------------------------------------------
# SISTARA ADMIN — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
# Everything here is OPTIONAL: with an empty file the admin runs fully in
# demo mode using seeded mock data and localStorage.
#
# IMPORTANT: only variables prefixed with VITE_ are exposed to the browser.
# NEVER put a secret key, service-role key or Razorpay SECRET in this file —
# those belong on a server.
# ---------------------------------------------------------------------------

# --- Supabase (auth + database) ----------------------------------------------
# Create a project, then copy the Project URL and the `anon` public key.
# The `anon` key is designed to be public; protect data with Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=